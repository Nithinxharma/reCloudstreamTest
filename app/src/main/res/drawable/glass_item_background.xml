<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D92D4058" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#75FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#E62C3C52" android:endColor="#D91B283A" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#8AFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#B8293445" android:endColor="#A6151D2A" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</selector>
