<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E63B4B63" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#8AFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#D92D3B50" />
            <corners android:radius="24dp" />
            <stroke android:width="1.5dp" android:color="#A6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#C52D3A4D" android:endColor="#B817202D" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#45FFFFFF" />
        </shape>
    </item>
</selector>
