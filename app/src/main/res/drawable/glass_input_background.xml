<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E6222E40" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D9212937" android:endColor="#C9161D2A" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#42FFFFFF" />
        </shape>
    </item>
</selector>
