<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#332E8BFF"/><stroke android:width="1.5dp" android:color="#AA8CBFFF"/><corners android:radius="18dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#332E8BFF"/><stroke android:width="1dp" android:color="#668CBFFF"/><corners android:radius="18dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#17FFFFFF"/><stroke android:width="1dp" android:color="#24FFFFFF"/><corners android:radius="18dp"/></shape>
    </item>
</selector>
