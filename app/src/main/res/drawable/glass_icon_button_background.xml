<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E63B4B63" />
            <stroke android:width="1dp" android:color="#8AFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#D92D3B50" />
            <stroke android:width="1.5dp" android:color="#A6FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#B8202A3A" />
            <stroke android:width="1dp" android:color="#42FFFFFF" />
        </shape>
    </item>
</selector>
